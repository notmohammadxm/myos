#!/bin/sh
set -eu

# MyOS Linux amd64 live desktop image.
# Run this script from linux/live-build after installing Debian live-build.
lb config \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends true \
  --bootappend-live "boot=live components hostname=myos username=user console=tty0 console=ttyS0,115200n8"
